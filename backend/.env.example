# Server
PORT=5000
NODE_ENV=development

# MongoDB
MONGODB_URI=mongodb://localhost:27017/akaleta

# JWT
JWT_SECRET=your_super_secret_jwt_key_change_in_production_min_32_chars
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=your_refresh_token_secret_change_in_production
JWT_REFRESH_EXPIRES_IN=30d

# DeepStack (ML Model Server)
DEEPSTACK_URL=http://localhost:80
DEEPSTACK_API_KEY=
DEEPSTACK_MODEL_NAME=nigerian-sign-language

# Python Detection Scripts
PYTHON_SCRIPTS_DIR=./ml_engine
PYTHON_EXECUTABLE=python3

# Email (Nodemailer)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
EMAIL_FROM=noreply@akaleta.ng
ADMIN_EMAIL=admin@akaleta.ng

# OpenAI (for chatbot NLP)
OPENAI_API_KEY=your_openai_api_key_here

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000

# File Upload
MAX_FILE_SIZE=10485760
UPLOAD_DIR=./uploads

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
